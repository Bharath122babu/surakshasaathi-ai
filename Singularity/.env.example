# ── Copy this file to .env and fill in your values ──────────────────────────
# DO NOT commit .env to git. Add .env to .gitignore.

# Required — Google Gemini API key (powers Stage A and Stage B analysis)
GEMINI_API_KEY=
# Defaults retained from the supplied source; override with models available
# to your account. Cloud model access has not been verified in this review.
GEMINI_MODEL=gemini-3.1-flash-lite-preview
EMBEDDING_MODEL=text-embedding-005
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for main_monitor.py — Gmail IMAP access
# Use a Gmail App Password (NOT your real password):
#   Google Account → Security → 2FA → App Passwords → Generate
GMAIL_ADDRESS=
GMAIL_APP_PASS=

# Telegram Bot (optional — enables Telegram alerts + /check bot interface)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Risk threshold (0-10). Emails scoring above this trigger alerts.
RISK_THRESHOLD=5
